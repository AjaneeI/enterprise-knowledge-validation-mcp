    {
      "name": "check_procedure_status",
      "title": null,
      "description": "Check synthetic procedure freshness. Use SOP-104@1.0 for a version or SOP-104 for current. Cite returned evidence and warnings; do not infer operational authorization.",
      "inputSchema": {
        "properties": {
          "procedure_id": {
            "maxLength": 40,
            "pattern": "^SOP-[0-9]{3}(@[0-9]+\\.[0-9]+)?$",
            "title": "Procedure Id",
            "type": "string"
          }
        },
        "required": [
          "procedure_id"
        ],
        "title": "check_procedure_statusArguments",
        "type": "object",
        "additionalProperties": false
      },
      "outputSchema": {
        "additionalProperties": false,
        "properties": {
          "procedure_id": {
            "title": "Procedure Id",
            "type": "string"
          },
          "found": {
            "title": "Found",
            "type": "boolean"
          },
          "status": {
            "enum": [
              "current",
              "superseded",
              "under_review",
              "unknown",
              "unavailable"
            ],
            "title": "Status",
            "type": "string"
          },
          "version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Version"
          },
          "is_superseded": {
            "default": false,
            "title": "Is Superseded",
            "type": "boolean"
          },
          "current_approved_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Current Approved Version"
          },
          "evidence_refs": {
            "items": {
              "type": "string"
            },
            "title": "Evidence Refs",
            "type": "array"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "title": "Warnings",
            "type": "array"
          },
          "decision": {
            "enum": [
              "eligible_for_review",
              "hold_for_review",
              "unknown"
            ],
            "title": "Decision",
            "type": "string"
          },
          "human_review_required": {
            "const": true,
            "default": true,
            "title": "Human Review Required",
            "type": "boolean"
          },
          "synthetic_demo": {
            "const": true,
            "default": true,
            "title": "Synthetic Demo",
            "type": "boolean"
          }
